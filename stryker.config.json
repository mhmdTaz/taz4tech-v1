{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "configFile": "vitest.mutation.config.ts",
    "related": false
  },
  "reporters": ["html", "json", "clear-text", "progress"],
  "htmlReporter": {
    "fileName": "stryker-report/index.html"
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/modules/*/domain/**/*.ts",
    "src/modules/*/application/**/*.ts",
    "src/modules/media/infrastructure/http-image-fetcher.ts",
    "src/modules/media/infrastructure/r2-image-repository.ts",
    "!src/modules/**/*.test.ts"
  ],
  "thresholds": {
    "high": 99,
    "low": 97,
    "break": 97
  },
  "timeoutMS": 20000,
  "concurrency": 4,
  "tempDirName": "node_modules/.stryker-tmp",
  "jsonReporter": {
    "fileName": "stryker-report/mutation.json"
  }
}
