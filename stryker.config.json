{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "configFile": "vitest.mutation.config.ts",
    "related": false
  },
  "reporters": ["html", "json", "clear-text", "progress"],
  "htmlReporter": {
    "fileName": "stryker-report/index.html"
  },
  "coverageAnalysis": "perTest",
  "mutate": ["src/modules/*/domain/**/*.ts", "!src/modules/*/domain/**/*.test.ts"],
  "thresholds": {
    "high": 97,
    "low": 94,
    "break": 94
  },
  "timeoutMS": 20000,
  "concurrency": 4,
  "tempDirName": "node_modules/.stryker-tmp",
  "jsonReporter": {
    "fileName": "stryker-report/mutation.json"
  }
}
