{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start",
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 120000,
      "url": [
        "http://127.0.0.1:3000/en",
        "http://127.0.0.1:3000/ar",
        "http://127.0.0.1:3000/fr",
        "http://127.0.0.1:3000/en/products",
        "http://127.0.0.1:3000/en/products/lenovo-ideapad-3"
      ],
      "numberOfRuns": 2,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "uses-responsive-images": "error",
        "unused-javascript": [
          "warn",
          {
            "maxLength": 1
          }
        ],
        "modern-image-formats": "off"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-report"
    }
  }
}
