# Copy to .env.local for development. Never commit a filled-in copy.

# --- required -----------------------------------------------------------------
# Atlas connection string. Create a database user scoped to this database only.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# --- optional, shown with their defaults --------------------------------------
MONGODB_DB=taz4tech
STORE_ID=taz4tech
SITE_URL=https://taz4tech.com
LOG_LEVEL=info
NODE_ENV=development

# --- admin area ---------------------------------------------------------------
# BOTH or NEITHER. Unset, /admin is a 404 and there is no admin area at all —
# which is the safe default for a first deploy. Setting only one is a startup
# error rather than a half-open door.
#
# Generate the secret with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs every open session out, which is how you revoke access.
# ADMIN_PASSWORD=at-least-twelve-characters
# ADMIN_SESSION_SECRET=at-least-thirty-two-characters-of-random

# --- feature flags ------------------------------------------------------------
# Every flag is off unless the value is exactly "on".
# TAZ_FLAG_EXCEL_IMPORTER=on
# TAZ_FLAG_WHATSAPP_TAP_TO_SEND=on
# TAZ_FLAG_WHATSAPP_CLOUD_API=on
# TAZ_FLAG_CARD_PAYMENTS=on
# TAZ_FLAG_LOYALTY=on

# --- integration tests only ---------------------------------------------------
# A throwaway database. The integration suite drops collections in it.
MONGODB_TEST_URI=mongodb://127.0.0.1:27017
MONGODB_TEST_DB=taz4tech_test
